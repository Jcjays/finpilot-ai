# FinPilot AI — backend environment template.
# Copy to backend/.env (git-ignored) and fill in real values. Never commit .env.
# Every variable below is read by the Ktor backend; the Android app never sees any of them
# except SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY, which are public by design.

# ---- Runtime ----
# local | ci | prod. Only "local" permits the HS256 dev secret below.
APP_ENV=local
PORT=8080

# ---- Database (PostgreSQL) ----
# Local Docker Compose default:
DATABASE_URL=jdbc:postgresql://localhost:5432/finpilot
DATABASE_USER=finpilot_api
DATABASE_PASSWORD=finpilot_api_dev_password
# Role used only by `./gradlew :data:migrate` (schema owner). Optional MIGRATION_DATABASE_URL overrides DATABASE_URL.
MIGRATION_DATABASE_USER=finpilot_migrator
MIGRATION_DATABASE_PASSWORD=finpilot_migrator_dev_password
# MIGRATION_DATABASE_URL=
# Hosted Supabase (Free plan has no IPv4 add-on → use the SESSION pooler, port 5432):
# DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_USER=finpilot_api.<project-ref>
# MIGRATION_DATABASE_USER=postgres.<project-ref>

# ---- Supabase Auth ----
# Project URL, e.g. https://abcdefghijklmnop.supabase.co  (local stack: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key — safe to ship in the Android app. Never the service-role / secret key.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# JWKS is derived from SUPABASE_URL: $SUPABASE_URL/auth/v1/.well-known/jwks.json
# Local-stack-only HS256 secret (the Supabase CLI demo value). Startup FAILS if set when APP_ENV != local.
AUTH_HS256_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ---- AI (Anthropic Claude) ----
# mock | claude. Mock is deterministic and free; use it for development and CI.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=claude. Prepaid API credits are required (no free tier).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional per-task overrides (default to ANTHROPIC_MODEL):
# ANTHROPIC_MODEL_EXTRACTION=
# ANTHROPIC_MODEL_CATEGORIZATION=
# ANTHROPIC_MODEL_INSIGHT=
# ANTHROPIC_MODEL_CHAT=
AI_DAILY_CALL_QUOTA_PER_USER=60
AI_MONTHLY_TOKEN_CEILING=2000000

# ---- Evaluation ----
# Set to true (together with ANTHROPIC_API_KEY) to allow the real-API evaluation run. Costs money.
FINPILOT_EVAL_REAL=false
